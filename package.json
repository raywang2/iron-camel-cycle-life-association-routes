{
  "name": "2026-iron-camel-routes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.scripts.json",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build:routes": "npm run build:scripts && node dist-scripts/scripts/build-routes.js",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "npm run build:scripts && node dist-scripts/scripts/validate-output.js"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
